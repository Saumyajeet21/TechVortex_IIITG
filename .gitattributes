# Auto-detect text files and normalize line endings
* text=auto

# Force LF for scripts and source files
*.py   text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf

# Force CRLF for Windows scripts
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary files — do not touch line endings
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pkl  binary
*.joblib binary
*.h5   binary
