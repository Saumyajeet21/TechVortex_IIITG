# ═══════════════════════════════════════════════════════════
#  OceanGuard — Environment Variables Template
#  Copy backend section → backend/.env
#  Copy frontend section → frontend/.env
# ═══════════════════════════════════════════════════════════

# ── BACKEND (backend/.env) ────────────────────────────────

# Carbon Price Configuration
CARBON_CREDIT_PRICE_USD=15.50       # Voluntary Carbon Market spot price
EU_ETS_PRICE_USD=75.00              # EU Emissions Trading Scheme (~60-90/tonne)
SOCIAL_COST_CARBON_USD=51.00        # US EPA Social Cost of Carbon

# External API Keys (app works without these — uses mock data as fallback)
GFW_API_TOKEN=                      # https://globalfishingwatch.org/our-apis/
COPERNICUS_USERNAME=                 # https://marine.copernicus.eu
COPERNICUS_PASSWORD=
NASA_EARTHDATA_TOKEN=               # https://urs.earthdata.nasa.gov

# Google Maps API (geocoding + coastal validation)
GOOGLE_MAPS_API_KEY=

# Gemini AI (cached per zone per day, rule-based fallback)
GEMINI_API_KEY=

# Supabase Database
SUPABASE_URL=
SUPABASE_ANON_KEY=

# App Config
USE_CACHE_DEFAULT=false
CACHE_TTL_HOURS=24

# ── FRONTEND (frontend/.env) — React + Vite ───────────────
# NOTE: All Vite env vars MUST start with VITE_ to be accessible in the browser

VITE_API_URL=http://localhost:8000
VITE_GOOGLE_MAPS_KEY=
