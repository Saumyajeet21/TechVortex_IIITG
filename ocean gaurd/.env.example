# Copy this file to backend/.env and fill in your values

# Carbon Price Configuration
CARBON_CREDIT_PRICE_USD=15.50       # Voluntary Carbon Market spot price
EU_ETS_PRICE_USD=75.00              # EU Emissions Trading Scheme (~60-90/tonne)
SOCIAL_COST_CARBON_USD=51.00        # US EPA Social Cost of Carbon

# External API Keys (app works without these — uses mock data as fallback)
GFW_API_TOKEN=                      # https://globalfishingwatch.org/our-apis/
COPERNICUS_USERNAME=                 # https://marine.copernicus.eu
COPERNICUS_PASSWORD=
NASA_EARTHDATA_TOKEN=               # https://urs.earthdata.nasa.gov

# App Config
USE_CACHE_DEFAULT=false
CACHE_TTL_HOURS=24
