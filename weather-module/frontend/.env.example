# Frontend Environment Variables
# Copy this file to .env and fill in your own values

# Supabase — https://supabase.com (create a free project)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API (local dev or deployed URL)
VITE_FORECAST_API_URL=http://localhost:8000

# Google Gemini AI — https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap (optional fallback) — https://openweathermap.org/api
VITE_OWM_API_KEY=your_owm_api_key_here
