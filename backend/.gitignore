# ─────────────────────────────────────────────
# Ocean AI Backend — .gitignore
# ─────────────────────────────────────────────

# Environment variables — NEVER commit these
.env
.env.*
*.env

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/
ENV/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Logs only
*.log

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Jupyter notebooks (if any)
.ipynb_checkpoints/
